{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "ruchaadfcentr"
		},
		"ls_AzureDataLakeStorage_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_AzureDataLakeStorage'"
		},
		"ls_AzureDataLakeStorage_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://ruchasta.dfs.core.windows.net/"
		},
		"ls_dataset_on_prem_properties_typeProperties_host": {
			"type": "string",
			"defaultValue": "C:\\"
		},
		"ls_dataset_on_prem_properties_typeProperties_userId": {
			"type": "string",
			"defaultValue": "DESKTOP-AJ37367\\X550C"
		},
		"ls_onprem_properties_typeProperties_host": {
			"type": "string",
			"defaultValue": "C:\\"
		},
		"ls_onprem_properties_typeProperties_userId": {
			"type": "string",
			"defaultValue": "DESKTOP-AJ37367\\X550C"
		},
		"ls_onprem_kv_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://ruchakv.vault.azure.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "ruchaadfcentr_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_AzureDataLakeStorage_accountKey": {
						"value": "[parameters('ls_AzureDataLakeStorage_accountKey')]"
					},
					"ls_AzureDataLakeStorage_properties_typeProperties_url": {
						"value": "[parameters('ls_AzureDataLakeStorage_properties_typeProperties_url')]"
					},
					"ls_onprem_kv_properties_typeProperties_baseUrl": {
						"value": "[parameters('ls_onprem_kv_properties_typeProperties_baseUrl')]"
					},
					"ls_dataset_on_prem_properties_typeProperties_host": {
						"value": "[parameters('ls_dataset_on_prem_properties_typeProperties_host')]"
					},
					"ls_dataset_on_prem_properties_typeProperties_userId": {
						"value": "[parameters('ls_dataset_on_prem_properties_typeProperties_userId')]"
					},
					"ls_onprem_properties_typeProperties_host": {
						"value": "[parameters('ls_onprem_properties_typeProperties_host')]"
					},
					"ls_onprem_properties_typeProperties_userId": {
						"value": "[parameters('ls_onprem_properties_typeProperties_userId')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}